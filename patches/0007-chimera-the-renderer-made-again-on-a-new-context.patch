+#if defined(CHIMERA)
+// chimera: a core profile has no GL_QUADS and no GL_QUAD_STRIP (the GPU
+// bridge's context is one). Those draws are drawn as triangles, two a quad:
+// an index list in the cache holds the triangles' indices, a draw without
+// one is given a list of its own (s_chimeraAutoQuads), and the count drawn
+// is the triangles'.
+static uint32 s_chimeraTriangleIndexCount = 0; // this draw's, when it is quads
+static GLuint s_chimeraAutoQuads[2] = {0, 0};  // QUADS, QUAD_STRIP
+static uint32 s_chimeraAutoQuadsVertices[2] = {0, 0}; // the vertices each list covers
+
+static bool ChimeraIsQuads(uint32 primitiveMode)
+{
+	return primitiveMode == (uint32)Latte::LATTE_VGT_PRIMITIVE_TYPE::E_PRIMITIVE_TYPE::QUADS ||
+		primitiveMode == (uint32)Latte::LATTE_VGT_PRIMITIVE_TYPE::E_PRIMITIVE_TYPE::QUAD_STRIP;
+}
+
+static uint32 ChimeraTriangleIndexCount(uint32 primitiveMode, uint32 count)
+{
+	if (primitiveMode == (uint32)Latte::LATTE_VGT_PRIMITIVE_TYPE::E_PRIMITIVE_TYPE::QUADS)
+		return count / 4 * 6;
+	return count >= 4 ? (count - 2) / 2 * 6 : 0;
+}
+
+// a quad's v0 v1 v2 v3 are the triangles v0 v1 v2 and v0 v2 v3; a quad
+// strip's quads are v0 v1 v3 v2, v2 v3 v5 v4, ...
+template<typename T>
+static void ChimeraQuadsToTriangles(uint32 primitiveMode, const T* in, uint32 count, T* out)
+{
+	if (primitiveMode == (uint32)Latte::LATTE_VGT_PRIMITIVE_TYPE::E_PRIMITIVE_TYPE::QUADS)
+	{
+		for (uint32 q = 0; q + 4 <= count; q += 4)
+		{
+			*out++ = in[q]; *out++ = in[q + 1]; *out++ = in[q + 2];
+			*out++ = in[q]; *out++ = in[q + 2]; *out++ = in[q + 3];
+		}
+		return;
+	}
+	for (uint32 i = 0; i + 4 <= count; i += 2)
+	{
+		*out++ = in[i]; *out++ = in[i + 1]; *out++ = in[i + 3];
+		*out++ = in[i]; *out++ = in[i + 3]; *out++ = in[i + 2];
+	}
+}
+
+// the decoded indices of a quads draw, as triangles, into the cache entry
+template<typename T>
+static uint32 ChimeraUploadTriangles(uint32 primitiveMode, uint32 count, uint32 offset)
+{
+	const uint32 triangles = ChimeraTriangleIndexCount(primitiveMode, count);
+	std::vector<T> out(triangles);
+	ChimeraQuadsToTriangles<T>(primitiveMode, (const T*)indexState.tempIndexStorage, count, out.data());
+	glBufferSubData(GL_ELEMENT_ARRAY_BUFFER, offset, triangles * sizeof(T), out.data());
+	return triangles;
+}
+
+// The index list of a quads draw without one: the vertices 0..n-1 as
+// triangles, made larger when a draw needs more.
+static GLuint ChimeraAutoQuads(uint32 primitiveMode, uint32 vertices)
+{
+	const int k = primitiveMode == (uint32)Latte::LATTE_VGT_PRIMITIVE_TYPE::E_PRIMITIVE_TYPE::QUADS ? 0 : 1;
+	if (s_chimeraAutoQuads[k] == 0 || s_chimeraAutoQuadsVertices[k] < vertices)
+	{
+		uint32 n = std::max<uint32>(vertices, 4096);
+		std::vector<uint32> sequence(n);
+		for (uint32 i = 0; i < n; i++)
+			sequence[i] = i;
+		std::vector<uint32> triangles(ChimeraTriangleIndexCount(primitiveMode, n));
+		ChimeraQuadsToTriangles<uint32>(primitiveMode, sequence.data(), n, triangles.data());
+		if (s_chimeraAutoQuads[k] == 0)
+			glGenBuffers(1, &s_chimeraAutoQuads[k]);
+		OpenGLRenderer::SetArrayElementBuffer(s_chimeraAutoQuads[k]);
+		glBufferData(GL_ELEMENT_ARRAY_BUFFER, triangles.size() * sizeof(uint32), triangles.data(), GL_STATIC_DRAW);
+		s_chimeraAutoQuadsVertices[k] = n;
+	}
+	return s_chimeraAutoQuads[k];
+}
+#endif
