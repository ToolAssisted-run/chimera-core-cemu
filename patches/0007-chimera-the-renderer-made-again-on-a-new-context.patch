 #define GPU7_INDEX_BUFFER_CACHE_SIZE_DEPR		(18*1024*1024) // 18MB
 
+#if defined(CHIMERA)
+void OpenGLSurfaceCopy_chimeraForgetContext();
+void OpenGLRenderer_chimeraForgetVertexArray();
+static bool s_chimeraIndexBufferGone = false;
+
+// chimera: what this file keeps of a GPU context is let go of when the
+// context moves (LatteThread_chimeraRemakeRenderer): the index lists cached
+// in the old context's buffer, the buffer itself (made again by draw_init),
+// what it remembers of the vertex array's state, the rectangle shaders and
+// the copy shaders.
+void OpenGLRenderer_chimeraForgetContext()
+{
+	LatteDrawGL_removeLeastRecentlyUsedIndexCacheEntries(0x7FFFFFFF);
+	if (indexState.initialized)
+	{
+		glDeleteBuffers(1, &indexState.glIndexCacheBuffer);
+		indexState.glIndexCacheBuffer = 0;
+		s_chimeraIndexBufferGone = true;
+	}
+	indexState.glActiveElementArrayBuffer = 0;
+	memset(glAttributeArrayIsEnabled, 0, sizeof(glAttributeArrayIsEnabled));
+	memset(glAttributeArrayAluDivisor, 0, sizeof(glAttributeArrayAluDivisor));
+	memset(_glVertexBufferOffset, 0, sizeof(_glVertexBufferOffset));
+	for (auto& it : g_mapGLRectEmulationGS)
+		delete it.second;
+	g_mapGLRectEmulationGS.clear();
+	sGLActiveDrawMode = 0;
+	s_chimeraTriangleIndexCount = 0;
+	for (int k = 0; k < 2; k++)
+	{
+		if (s_chimeraAutoQuads[k])
+			glDeleteBuffers(1, &s_chimeraAutoQuads[k]);
+		s_chimeraAutoQuads[k] = 0;
+		s_chimeraAutoQuadsVertices[k] = 0;
+	}
+	OpenGLSurfaceCopy_chimeraForgetContext();
+	OpenGLRenderer_chimeraForgetVertexArray();
+}
+#endif
