+// chimera: the context the renderer's objects were made in (0: none yet). It
+// lives in the machine's memory, so a state remembers the context of the
+// process that saved it, and a load in another one - or the new context the
+// frontend gives after any load - is noticed.
+uint64 s_chimeraGpuContext = 0;
+
+// The renderer made again on a new GPU context. Everything it holds - the
+// textures, the shaders, the buffers, its own objects - is a cache of the
+// console's memory and the GPU's registers, which a state holds; so all of
+// it is dropped and made again as the GPU needs it. Dropped first (the old
+// names delete nothing now), made after, so no new object is given a name
+// an old call could still reach.
+static void LatteThread_chimeraRemakeRenderer()
+{
+	cemuLog_log(LogType::Force, "chimera: the GPU context moved; making the renderer again");
+	LatteBufferCache_UnloadAll();
+	LatteTC_UnloadAllTextures();
+	LatteSHRC_UnloadAll();
+	RendererOutputShader::ShutdownStatic();
+	OpenGLRenderer_chimeraForgetContext();
+	chimera_gpu_context_forget();
+	ImGui_ImplOpenGL3_DestroyDeviceObjects();
+	{
+		Renderer* old = g_renderer.release();
+		auto renderer = std::make_unique<OpenGLRenderer>();
+		renderer->ChimeraTakeImgui(*old);
+		delete old; // its last objects' old names
+		g_renderer = std::move(renderer);
+	}
+	g_renderer->Initialize();
+	RendererOutputShader::InitializeStatic();
+	LatteTexture_init();
+	LatteTC_Init();
+	LatteBufferCache_init(164 * 1024 * 1024);
+	LatteQuery_Init();
+	LatteSHRC_Init();
+	LatteStreamout_InitCache();
+	sint32 w, h;
+	WindowSystem::GetWindowPhysSize(w, h);
+	g_renderer->renderTarget_setViewport(0, 0, w, h, 0.0f, 1.0f);
+	s_chimeraGpuContext = chimera_gpu_context_id();
