+// of one scheduler on the machine's own clock.
+#if defined(CHIMERA)
+#include "chimera_vsched.h"
+#define CEMU_THREAD chimera::Thread
+#define CEMU_MUTEX chimera::Mutex
+#define CEMU_RECURSIVE_MUTEX chimera::RecursiveMutex
+#define CEMU_CONDVAR chimera::ConditionVariable
+#define CEMU_SLEEP_FOR(d) chimera::this_task::sleep_for(d)
+#define CEMU_YIELD() chimera::this_task::yield()
+#define CEMU_ASYNC(...) chimera::Async(__VA_ARGS__)
+// the host's clocks, where upstream reads them for the machine: the
+// machine's clock (since power-on) and calendar (from the setting) instead
+int64_t chimera_clock_start();
+#define CEMU_STEADY_NOW() (std::chrono::steady_clock::time_point(std::chrono::nanoseconds(chimera::vsched::NowNs())))
+#define CEMU_SYSTEM_NOW() (std::chrono::system_clock::time_point(std::chrono::duration_cast<std::chrono::system_clock::duration>(std::chrono::seconds(chimera_clock_start()) + std::chrono::nanoseconds(chimera::vsched::NowNs()))))
+// a host's random numbers make another machine every run: a fixed seed
+// instead, the same everywhere (std::random_device asks the processor)
+#define CEMU_RANDOM_SEED() (0x43454D55u)
+#define CEMU_RANDOM_ENGINE(name) static std::mt19937 name(CEMU_RANDOM_SEED())
+// the console's common key, which the user gives (ncrypto.cpp asks for it):
+// false, and zeros, when none was given
+bool chimera_common_key(uint8_t* out16);
+#else
+#define CEMU_THREAD std::thread
+#define CEMU_MUTEX std::mutex
+#define CEMU_RECURSIVE_MUTEX std::recursive_mutex
+#define CEMU_CONDVAR std::condition_variable
+#define CEMU_SLEEP_FOR(d) std::this_thread::sleep_for(d)
+#define CEMU_YIELD() std::this_thread::yield()
+#define CEMU_ASYNC(...) std::async(std::launch::async, __VA_ARGS__)
+#define CEMU_RANDOM_SEED() (std::random_device{}())
+#define CEMU_RANDOM_ENGINE(name) std::random_device name##_device; std::mt19937 name(name##_device())
+#define CEMU_STEADY_NOW() (std::chrono::steady_clock::now())
+#define CEMU_SYSTEM_NOW() (std::chrono::system_clock::now())
+#endif
