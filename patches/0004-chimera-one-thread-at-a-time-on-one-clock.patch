+			return id;
+		}
+
+		bool GetCommunityIdFromCode(uint32* pOutId, const char* pCode)
+		{
+			if (!EnsureCommunityCode((char*)pCode))
+				return false;
+
+			*pOutId = ExtractCommunityIdFromCode((char*)pCode);
