+#if defined(CHIMERA)
+// chimera: the copy shaders' programs belong to the GPU context they were
+// made in; on a new one they are made again when next asked for
+void OpenGLSurfaceCopy_chimeraForgetContext()
+{
+	for (LatteGLDefaultShader_t** shader : {&_copyShader_depthToColor, &_copyShader_colorToDepth})
+	{
