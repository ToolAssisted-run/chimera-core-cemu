+void GraphicPack2::ChimeraForgetOutputShaders()
+{
+	m_output_shader.reset();
+	m_upscaling_shader.reset();
+	m_downscaling_shader.reset();
+	m_output_shader_ud.reset();
+	m_upscaling_shader_ud.reset();
+	m_downscaling_shader_ud.reset();
+}
+#endif
 
 std::vector<GraphicPackPtr> GraphicPack2::s_graphic_packs;
 std::vector<GraphicPackPtr> GraphicPack2::s_active_graphic_packs;
@@ -246,6 +262,18 @@ void GraphicPack2::ClearGraphicPacks()
 
 void GraphicPack2::WaitUntilReady()
 {
+#if defined(CHIMERA)
+	// chimera: the GPU waits on the machine's clock until the packs of the
+	// title are activated (ActivateForCurrentTitle). With no pack for the
+	// title (a project gives none, or none that names this title) there is
+	// nothing to wait for, and the run is the one it was without packs.
+	const uint64 titleId = CafeSystem::GetForegroundTitleId();
+	if (std::none_of(s_graphic_packs.begin(), s_graphic_packs.end(),
+		[titleId](const GraphicPackPtr& gp) { return gp->IsEnabled() && gp->ContainsTitleId(titleId); }))
+		return;
+	chimera::vsched::Wait([]() { return s_isReady.load(); });
+	return;
+#endif
 	while (!s_isReady)
 		std::this_thread::sleep_for(std::chrono::milliseconds(5));
 }
