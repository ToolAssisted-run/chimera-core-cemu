   "R": "r",
   "ZL": "z",
   "ZR": "Z",
   "Plus": "+",
   "Minus": "-",
   "Home": "H",
   "Left Stick": "<",
   "Right Stick": ">",
   "Touch": "T"
  },
  "axes": [
   {
    "name": "P1 Left Stick X",
    "min": -32768,
    "max": 32767,
    "neutral": 0,
    "header": "LX"
   },
   {
    "name": "P1 Left Stick Y",
    "min": -32768,
    "max": 32767,
    "neutral": 0,
    "header": "LY"
   },
   {
    "name": "P1 Right Stick X",
    "min": -32768,
    "max": 32767,
    "neutral": 0,
    "header": "RX"
   },
   {
    "name": "P1 Right Stick Y",
    "min": -32768,
    "max": 32767,
    "neutral": 0,
    "header": "RY"
   },
   {
    "name": "P1 Touch X",
    "min": 0,
    "max": 65535,
    "neutral": 32768,
    "header": "TX"
   },
   {
    "name": "P1 Touch Y",
    "min": 0,
    "max": 65535,
    "neutral": 32768,
    "header": "TY"
   }
  ]
 },
 "extensions": {
  ".rpx": "WIIU",
  ".wua": "WIIU",
  ".wuhb": "WIIU"
 },
