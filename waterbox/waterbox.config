   "options": [
    "console",
    "none"
   ],
   "optionLabels": {
    "console": "setting.mii_resource.option.console",
    "none": "setting.mii_resource.option.none"
   },
   "default": "console",
   "description": "setting.mii_resource.about"
  },
  {
   "name": "occlusion_queries",
   "display": "setting.occlusion_queries",
   "type": "enum",
   "options": [
